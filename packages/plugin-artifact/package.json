{
  "name": "@editful/plugin-artifact",
  "version": "0.9.0",
  "description": "Platform-neutral validation for Editful plugin artifacts.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/samschooler/editful-canvas-sdk.git",
    "directory": "packages/plugin-artifact"
  },
  "homepage": "https://github.com/samschooler/editful-canvas-sdk#readme",
  "bugs": "https://github.com/samschooler/editful-canvas-sdk/issues",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist/**/*.js",
    "dist/**/*.js.map",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map",
    "README.md"
  ],
  "scripts": {
    "build": "tsc --build tsconfig.build.json",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "acorn": "^8.17.0",
    "es-module-lexer": "^2.3.1"
  }
}

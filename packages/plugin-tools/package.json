{
  "name": "@editful/plugin-tools",
  "version": "0.11.0",
  "description": "Build, validate, watch, and package Editful canvas plugins.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/editful/sdk.git",
    "directory": "packages/plugin-tools"
  },
  "homepage": "https://github.com/editful/sdk#readme",
  "bugs": "https://github.com/editful/sdk/issues",
  "type": "module",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "engines": {
    "node": ">=26"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "editful-plugin": "dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist/**/*.js",
    "dist/**/*.js.map",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map",
    "README.md"
  ],
  "scripts": {
    "build": "tsc --build tsconfig.build.json && node ../../scripts/mark-executable.mjs dist/cli.js",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@editful/plugin-artifact": "workspace:*",
    "rolldown": "^1.1.5"
  },
  "devDependencies": {
    "@editful/canvas-sdk": "workspace:*",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  }
}

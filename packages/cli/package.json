{
  "name": "@editful/cli",
  "version": "0.9.1",
  "description": "Create and manage Editful canvas plugin projects.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/editful/sdk.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/editful/sdk#readme",
  "bugs": "https://github.com/editful/sdk/issues",
  "type": "module",
  "publishConfig": {
    "access": "public",
    "registry": "https://npm.pkg.github.com"
  },
  "engines": {
    "node": ">=26"
  },
  "bin": {
    "editful": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist/**/*.js",
    "dist/**/*.js.map",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map",
    "README.md"
  ],
  "scripts": {
    "build": "tsc --build tsconfig.build.json",
    "prepack": "pnpm build"
  }
}

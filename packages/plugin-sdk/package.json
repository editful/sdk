{
  "name": "@editful/plugin-sdk",
  "version": "0.9.0",
  "description": "Public TypeScript authoring contract for Editful canvas plugins.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/editful/editful-canvas-sdk.git",
    "directory": "packages/plugin-sdk"
  },
  "homepage": "https://github.com/editful/editful-canvas-sdk#readme",
  "bugs": "https://github.com/editful/editful-canvas-sdk/issues",
  "type": "module",
  "publishConfig": {
    "access": "public",
    "registry": "https://npm.pkg.github.com"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist/**/*.js",
    "dist/**/*.js.map",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map",
    "README.md"
  ],
  "scripts": {
    "build": "tsc --build tsconfig.build.json",
    "prepack": "pnpm build"
  }
}
